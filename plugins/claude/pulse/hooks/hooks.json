{
  "description": "Pulse Chat: hand messages waiting for this chat to Claude.",
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-pulse.exe", "args": ["claude-hook"], "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-pulse.exe", "args": ["claude-hook"], "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-pulse.exe", "args": ["claude-hook"], "timeout": 10 } ] }
    ]
  }
}
